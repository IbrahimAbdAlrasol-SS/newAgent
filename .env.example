# =================================================================
# LLM PROVIDER CONFIGURATION
# =================================================================

# Provider type: local, groq, openai
LLM_PROVIDER=local

# Model name (provider-specific)
LLM_MODEL=qwen2.5:7b-instruct

# Generation parameters
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# =================================================================
# LOCAL LLM (Ollama)
# =================================================================

# Ollama server URL
OLLAMA_BASE_URL=http://localhost:11434

# =================================================================
# GROQ CLOUD API
# =================================================================

# Groq API key (get from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# =================================================================
# OPENAI API
# =================================================================

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# =================================================================
# EMBEDDINGS CONFIGURATION
# =================================================================

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=intfloat/multilingual-e5-large

# Embedding dimension
EMBEDDING_DIM=1024

# =================================================================
# VECTOR STORE (ChromaDB)
# =================================================================

# ChromaDB persistence directory
# Canonical backend key:
CHROMA_PERSIST_DIRECTORY=./data/chromadb
# Backward-compatible alias (legacy docs):
CHROMADB_PERSIST_DIR=./chromadb

# ChromaDB host (if using server mode)
# CHROMADB_HOST=localhost
# CHROMADB_PORT=8000

# =================================================================
# DATABASE CONFIGURATION
# =================================================================

# PostgreSQL connection
DATABASE_URL=postgresql+asyncpg://meta_user:meta_password@localhost:5432/meta_genai

# =================================================================
# REDIS CONFIGURATION
# =================================================================

# Redis connection
REDIS_URL=redis://localhost:6379/0

# =================================================================
# META/INSTAGRAM INTEGRATION
# =================================================================

# Meta App credentials (from Meta Developer Portal)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Webhook verification token
META_VERIFY_TOKEN=your_random_verification_token

# =================================================================
# CELERY CONFIGURATION
# =================================================================

# Celery broker (Redis)
CELERY_BROKER_URL=redis://localhost:6379/1

# Celery result backend
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =================================================================
# APPLICATION SETTINGS
# =================================================================

# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode
DEBUG=true

# API secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =================================================================
# LOGGING
# =================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log format
LOG_FORMAT=json

# =================================================================
# TESTING
# =================================================================

# Test database URL
TEST_DATABASE_URL=postgresql+asyncpg://meta_user:meta_password@127.0.0.1:5432/meta_genai_test

# Test Redis URL
TEST_REDIS_URL=redis://localhost:6379/10
